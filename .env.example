# 数据库
POSTGRES_USER=tablemind
POSTGRES_PASSWORD=tablemind
POSTGRES_DB=tablemind
DATABASE_URL=postgresql+asyncpg://tablemind:tablemind@localhost:5432/tablemind

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 大模型 / Embedding（OpenAI 兼容端点，默认阿里云百炼 DashScope）
# 百炼 OpenAI 兼容地址：https://dashscope.aliyuncs.com/compatible-mode/v1
# 注意：模型 ID 以 /v1/models 返回的 id 为准。曾用 deepseek-v4.1-flash，
# 2026-10-14 其免费额度耗尽（403 AllocationQuota.FreeTierOnly），改用 qwen-flash；
# 2026-10-27 qwen-flash 额度也耗尽，qwen-plus / qwen-max 仍可用 → 当前 qwen-plus。
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 主模型额度耗尽/限流时自动切换的备用模型（按顺序尝试）
LLM_FALLBACK_MODELS=qwen-max,qwen-turbo
LLM_MAX_TOKENS=1600
LLM_TIMEOUT=90
# 嵌入模型维度必须与 rule_documents.embedding(Vector) 一致（列固定为 1536）；
# v4/v2 免费额度已耗尽，当前用 text-embedding-v1（默认 1536 维，且额度可用）。
# 换嵌入模型必须全量重灌向量（不同模型的向量空间不可混用），见 .workbuddy/tmp/reembed_all.py
EMBEDDING_MODEL=text-embedding-v1

# Agentic RAG 状态图（rewrite → retrieve → grade → generate → check）
# 任一环节异常会回落到旧流水线，因此默认可开。
AGENTIC_RAG_ENABLED=true
# 检索不足时的最大检索次数（含首次），达到后走 L4 降级
AGENTIC_MAX_RETRIES=3
# 幻觉检查不通过时的最大检查次数，达到后保留回答并追加「以官方说明书为准」
AGENTIC_MAX_CHECK_RETRIES=2
# 生成后的事实核查（LLM-as-judge）
AGENTIC_CHECK_ENABLED=true
# L1 结构化资料是否再用 LLM 判定能否回答（默认关闭以控制首字延迟）
AGENTIC_GRADE_LLM_ENABLED=false

# ---- Advanced RAG：混合检索 / 查询增强 / 重排 ----
# 融合方式：score=两路归一化后加权（默认，保留领先幅度）；rrf=Reciprocal Rank Fusion（只看名次）
RAG_FUSION=score
RAG_VECTOR_WEIGHT=1.0
RAG_BM25_WEIGHT=1.6
# 每路查询在 pgvector（HNSW）里取多少个 Top-N 候选参与融合；池外切片记 0 分，仍可由 BM25 召回
RAG_VECTOR_POOL=60
# BM25 中文分词：auto=装了 jieba 就用、否则二元组；jieba=强制；bigram=强制二元组
RAG_BM25_TOKENIZER=auto
# 查询改写（口语 → 规则书措辞）：每轮多一次轻量 LLM 调用
RAG_QUERY_EXPAND_ENABLED=true
# HyDE：让 LLM 先写一段假设的规则书原文，仅用于向量路检索；默认关闭以省一次 LLM 调用
HYDE_ENABLED=false
# 重排：gte=gte-rerank-v2（百炼 cross-encoder，一次 HTTP 调用）；llm=大模型点式打分；score=按融合分
RERANK_ENABLED=true
RERANK_TOP_N=15
RERANK_METHOD=gte
RERANK_MODEL=gte-rerank-v2
# 父子分块回填：子片匹配、父章节供模型阅读（历史切片无父片信息时自动回落）
PARENT_FILL_ENABLED=true
PARENT_MAX_CHARS=1600

# ---- P3 四维评测（LLM-as-judge）----
# 裁判模型留空则跟随 LLM_MODEL；温度固定 0 保证同一批次打分可比
EVAL_JUDGE_MODEL=
EVAL_JUDGE_MAX_TOKENS=1200
EVAL_JUDGE_TEMPERATURE=0.0
# 评测回答的最大输出（与线上一致的生成模型，统一输出后仅作兜底）
EVAL_ANSWER_MAX_TOKENS=6000
# 同批次并发条数：每条独立 DB session，过大易触发模型限流
EVAL_CONCURRENCY=2
# 单条 overall 低于该值记为未通过（通过率按此计算）
EVAL_PASS_THRESHOLD=0.6
