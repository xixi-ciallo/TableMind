# 数据库
POSTGRES_USER=tablemind
POSTGRES_PASSWORD=tablemind
POSTGRES_DB=tablemind
DATABASE_URL=postgresql+asyncpg://tablemind:tablemind@localhost:5432/tablemind

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 大模型 / Embedding（OpenAI 兼容端点，默认阿里云百炼 DashScope）
# 百炼 OpenAI 兼容地址：https://dashscope.aliyuncs.com/compatible-mode/v1
# 注意：模型 ID 以 /v1/models 返回的 id 为准。曾用 deepseek-v4.1-flash，
# 但 2026-10-14 其免费额度耗尽（403 AllocationQuota.FreeTierOnly），改用 qwen-flash
# （非推理模型，流式/function calling 均可用，首字更快）。充值后可改回。
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash
LLM_MAX_TOKENS=1600
LLM_TIMEOUT=90
# 嵌入模型维度必须与 rule_documents.embedding(Vector) 一致（列固定为 1536）；
# v4/v2 免费额度已耗尽，当前用 text-embedding-v1（默认 1536 维，且额度可用）。
# 换嵌入模型必须全量重灌向量（不同模型的向量空间不可混用），见 .workbuddy/tmp/reembed_all.py
EMBEDDING_MODEL=text-embedding-v1
